{
  "name": "webgpu-search-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:mock": "bun scripts/test-vgpu-mock.ts",
    "test:headless": "bun scripts/test-vgpu-mock.ts",
    "test:contracts": "bun scripts/test-contracts.ts",
    "test:records": "bun scripts/test-document-records.ts",
    "test:highlight": "bun scripts/test-highlight.ts",
    "test:mutations": "bun scripts/test-mutations.ts",
    "test:worker": "bun scripts/test-worker.ts",
    "test:snapshot": "bun scripts/test-snapshot.ts",
    "test:observability": "bun scripts/test-observability.ts",
    "test:filtering": "bun scripts/test-filtering.ts",
    "test:faceting": "bun scripts/test-faceting.ts",
    "test:diagnostics": "bun test packages/webgpu-search/test/diagnostics.test.ts",
    "test:search-modes": "bun test packages/webgpu-search/test/search-modes.test.ts",
    "test:parity": "bun scripts/test-parity-harness.ts",
    "test:reliability": "bun scripts/test-reliability.ts",
    "test:cpu-baseline": "bun scripts/test-cpu-baseline.ts",
    "test:benchmarks": "bun scripts/test-benchmarks.ts",
    "test:compatibility": "bun run test:mock && bun run test:contracts && bun run test:parity && bun run test:search-modes && bun run test:cpu-baseline && bun run test:reliability && bun run test:benchmarks",
    "test:normalization": "bun scripts/test-text-normalization.ts",
    "test:normalization:tr": "LANG=tr_TR.UTF-8 LC_ALL=tr_TR.UTF-8 bun scripts/test-text-normalization.ts",
    "lint:parity": "bun scripts/check-parity-lint.ts",
    "lint:naming": "bun scripts/check-naming.ts",
    "check:bundle-size": "bun scripts/check-bundle-size.ts",
    "check:bundle": "bun scripts/check-bundle-size.ts",
    "check:public-api": "bun scripts/check-public-api.ts",
    "check:case-fold": "bun scripts/generate-case-fold-table.ts --check",
    "check:fold": "bun scripts/generate-case-fold-table.ts --check",
    "test:browser": "bun scripts/test-regression.ts",
    "test:benchmark": "bun scripts/run-all-benchmarks.ts",
    "test:benchmark:fuzzy": "bun scripts/run-fuzzy-benchmark.ts",
    "bench:snapshot-matrix": "bun scripts/bench-snapshot-matrix.ts",
    "test:all": "bun run test:headless && bun run test:contracts && bun run test:records && bun run test:highlight && bun run test:mutations && bun run test:worker && bun run test:snapshot && bun run test:observability && bun run test:normalization && bun run test:normalization:tr && bun run test:filtering && bun run test:faceting && bun run test:diagnostics && bun run test:search-modes && bun run test:parity && bun run test:cpu-baseline && bun run test:reliability && bun run test:benchmarks",
    "check:shaders": "turbo check:shaders",
    "typecheck": "turbo typecheck && bun x tsc -p examples/tsconfig.json --noEmit",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "prepublish:check": "turbo check:shaders && turbo typecheck && turbo build && bun scripts/test-vgpu-mock.ts && bun run test:browser",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@webgpu/types": "^0.1.72",
    "puppeteer-core": "^25.10.0",
    "react": "^19.3.0",
    "svelte": "^5.57.1",
    "turbo": "^2.4.4",
    "typescript": "~6.0.2",
    "vgpu": "^0.5.0",
    "vue": "^3.5.43",
    "webgpu-search": "workspace:*"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  }
}
