{
  "name": "webgpu-search-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:mock": "bun scripts/test-vgpu-mock.ts",
    "test:m1": "bun scripts/test-m1-contracts.ts",
    "test:m2": "bun scripts/test-m2-records.ts",
    "test:m3": "bun scripts/test-m3-highlight.ts",
    "test:m4": "bun scripts/test-m4-mutations.ts",
    "test:m5": "bun scripts/test-m5-worker.ts",
    "test:m6": "bun scripts/test-m6-persistence.ts",
    "test:m7": "bun scripts/test-m7-observability.ts",
    "test:m8": "bun scripts/test-m8-proof-apps.ts",
    "test:filter": "bun scripts/test-m2-filter.ts",
    "test:facets": "bun scripts/test-m3-facets.ts",
    "test:search-modes": "bun test packages/webgpu-search/test/search-modes.test.ts",
    "test:parity": "bun scripts/test-m4-parity.ts",
    "test:preprocess": "bun scripts/test-m2-preprocess.ts",
    "test:preprocess:tr": "LANG=tr_TR.UTF-8 LC_ALL=tr_TR.UTF-8 bun scripts/test-m2-preprocess.ts",
    "lint:parity": "bun scripts/check-parity-lint.ts",
    "check:bundle": "bun scripts/check-m2-bundle.ts",
    "check:fold": "bun scripts/generate-fold-table.ts --check",
    "test:browser": "bun scripts/test-regression.ts",
    "test:benchmark": "bun scripts/run-all-benchmarks.ts",
    "test:benchmark:fuzzy": "bun scripts/run-fuzzy-benchmark.ts",
    "test:all": "bun run test:mock && bun run test:m1 && bun run test:m2 && bun run test:m3 && bun run test:m4 && bun run test:m5 && bun run test:m6 && bun run test:m7 && bun run test:m8 && bun run test:preprocess && bun run test:preprocess:tr && bun run test:filter && bun run test:facets && bun run test:search-modes && bun run test:parity",
    "check:shaders": "turbo check:shaders",
    "typecheck": "turbo typecheck && bun x tsc -p examples/tsconfig.json --noEmit",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "prepublish:check": "turbo check:shaders && turbo typecheck && turbo build && bun scripts/test-vgpu-mock.ts && bun run test:browser",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@webgpu/types": "^0.1.72",
    "puppeteer-core": "^25.10.0",
    "react": "^19.3.0",
    "svelte": "^5.57.1",
    "turbo": "^2.4.4",
    "typescript": "~6.0.2",
    "vgpu": "^0.5.0",
    "vue": "^3.5.43",
    "webgpu-search": "workspace:*"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  }
}
