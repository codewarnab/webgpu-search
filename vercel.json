{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "apps/site/dist",
  "redirects": [
    { "source": "/benchmark/:path*", "destination": "/#benchmark", "permanent": true },
    { "source": "/compare/:path*", "destination": "/#benchmark", "permanent": true }
  ],
  "ignoreCommand": "if [ \"$VERCEL_ENV\" == \"production\" ]; then exit 1; else exit 0; fi"
}
